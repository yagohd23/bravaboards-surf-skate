{
  "kind": "collectionType",
  "collectionName": "disciplines",
  "info": {
    "singularName": "discipline",
    "pluralName": "disciplines",
    "displayName": "discipline"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "seo_data": {
      "type": "component",
      "component": "seo-components.seo",
      "repeatable": false,
      "required": true
    }
  }
}
