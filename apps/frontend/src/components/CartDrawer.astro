---
/**
 * CartDrawer — BravaBoards
 * Drawer lateral del carrito de compra. Siempre presente en el DOM (via BaseLayout).
 * Escucha eventos 'cart:add' y 'cart:open'. Persiste en localStorage.
 * Sin texto hardcodeado — todas las etiquetas vienen de ui_labels (Strapi).
 */
import type { UILabels } from '../types/strapi';

interface Props {
  ui: UILabels;
}

const { ui } = Astro.props;
---

<!-- Overlay backdrop -->
<div
  id="cart-overlay"
  class="fixed inset-0 bg-navy/60 z-40 opacity-0 invisible transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Panel del drawer -->
<aside
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full max-w-sm bg-warm-white shadow-2xl z-50 flex flex-col translate-x-full transition-transform duration-300"
  aria-hidden="true"
  data-empty-label={ui.cart_empty ?? ''}
  data-remove-label={ui.cart_remove ?? ''}
>
  <!-- Cabecera -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-sand-dark flex-shrink-0">
    <h2 class="font-semibold text-navy">{ui.cart_title ?? ''}</h2>
    <button
      id="cart-close-btn"
      class="flex items-center justify-center w-8 h-8 rounded-md text-stone hover:text-navy hover:bg-sand transition-colors"
      aria-label={ui.cart_title ?? ''}
      type="button"
    >
      <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Lista de productos (poblada por JS) -->
  <div id="cart-items-container" class="flex-1 overflow-y-auto px-5 py-4"></div>

  <!-- Footer: total + checkout -->
  <div id="cart-footer-bar" class="border-t border-sand-dark px-5 py-4 flex-shrink-0 hidden">
    <div class="flex items-center justify-between mb-4">
      <span class="text-sm font-semibold text-navy">{ui.cart_total ?? ''}</span>
      <span id="cart-total-amount" class="text-base font-bold text-ocean"></span>
    </div>
    <button
      id="cart-checkout-btn"
      class="w-full px-4 py-3 bg-ocean text-warm-white text-sm font-medium rounded-md hover:bg-ocean-light transition-colors duration-200"
      type="button"
    >
      {ui.cart_checkout ?? ''}
    </button>
  </div>
</aside>

<script>
  const CART_KEY = 'bravaboards_cart';

  interface CartItem {
    id: number;
    name: string;
    price: number;
    priceFormatted: string;
    imageUrl: string;
    imageAlt: string;
    quantity: number;
  }

  function esc(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function loadCart(): CartItem[] {
    try { return JSON.parse(localStorage.getItem(CART_KEY) ?? '[]'); } catch { return []; }
  }

  function saveCart(items: CartItem[]): void {
    localStorage.setItem(CART_KEY, JSON.stringify(items));
  }

  function formatPrice(amount: number): string {
    return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(amount);
  }

  const drawer   = document.getElementById('cart-drawer') as HTMLElement;
  const overlay  = document.getElementById('cart-overlay') as HTMLElement;
  const itemsEl  = document.getElementById('cart-items-container') as HTMLElement;
  const footerEl = document.getElementById('cart-footer-bar') as HTMLElement;
  const totalEl  = document.getElementById('cart-total-amount') as HTMLElement;

  const emptyLabel  = drawer.dataset.emptyLabel  ?? '';
  const removeLabel = drawer.dataset.removeLabel ?? '';

  function renderCart(): void {
    const items = loadCart();
    const total = items.reduce((s, i) => s + i.price * i.quantity, 0);
    const count = items.reduce((s, i) => s + i.quantity, 0);

    if (items.length === 0) {
      itemsEl.innerHTML = `
        <div class="flex flex-col items-center justify-center h-40 text-center py-8">
          <svg class="w-12 h-12 text-stone-light mb-3" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M8 10h4l7 22h18l4-14H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="22" cy="38" r="2.5" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="34" cy="38" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <p class="text-sm text-stone">${esc(emptyLabel)}</p>
        </div>`;
      footerEl.classList.add('hidden');
    } else {
      itemsEl.innerHTML = items.map(item => `
        <div class="flex gap-3 py-3 border-b border-sand-dark last:border-0">
          <div class="w-16 h-16 rounded-lg overflow-hidden bg-sand flex-shrink-0">
            ${item.imageUrl
              ? `<img src="${esc(item.imageUrl)}" alt="${esc(item.imageAlt)}" class="w-full h-full object-cover" loading="lazy" />`
              : `<div class="w-full h-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-stone-light" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.2"/>
                    <circle cx="9" cy="9" r="2" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M3 16l5-5 4 4 3-3 6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                </div>`
            }
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-navy leading-snug">${esc(item.name)}</p>
            <p class="text-sm font-bold text-ocean mt-0.5">${esc(item.priceFormatted)}</p>
            <div class="flex items-center gap-2 mt-2">
              <button
                class="w-6 h-6 rounded border border-sand-dark flex items-center justify-center text-stone hover:text-navy hover:border-ocean-light transition-colors"
                data-qty-dec="${item.id}"
                type="button"
                aria-label="−"
              >−</button>
              <span class="text-sm font-medium text-navy w-5 text-center select-none">${item.quantity}</span>
              <button
                class="w-6 h-6 rounded border border-sand-dark flex items-center justify-center text-stone hover:text-navy hover:border-ocean-light transition-colors"
                data-qty-inc="${item.id}"
                type="button"
                aria-label="+"
              >+</button>
              <button
                class="ml-auto text-xs text-stone-light hover:text-coral transition-colors"
                data-cart-remove="${item.id}"
                type="button"
              >${esc(removeLabel)}</button>
            </div>
          </div>
        </div>
      `).join('');

      totalEl.textContent = formatPrice(total);
      footerEl.classList.remove('hidden');
    }

    // Notifica el badge del header
    document.dispatchEvent(new CustomEvent('cart:change', { detail: { count } }));
  }

  function openCart(): void {
    drawer.classList.remove('translate-x-full');
    overlay.classList.remove('opacity-0', 'invisible');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeCart(): void {
    drawer.classList.add('translate-x-full');
    overlay.classList.add('opacity-0', 'invisible');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // ── Eventos externos ─────────────────────────────────────────────────────────

  document.addEventListener('cart:add', ((e: CustomEvent) => {
    const p = e.detail as {
      id: number; name: string; priceRaw: number; priceFormatted: string;
      imageUrl: string; imageAlt: string;
    };
    const items = loadCart();
    const existing = items.find(i => i.id === p.id);
    if (existing) {
      existing.quantity++;
    } else {
      items.push({
        id: p.id,
        name: p.name,
        price: p.priceRaw,
        priceFormatted: p.priceFormatted,
        imageUrl: p.imageUrl ?? '',
        imageAlt: p.imageAlt ?? '',
        quantity: 1,
      });
    }
    saveCart(items);
    renderCart();
    openCart();
  }) as EventListener);

  document.addEventListener('cart:open', openCart);

  // ── Controles internos ───────────────────────────────────────────────────────

  document.getElementById('cart-close-btn')?.addEventListener('click', closeCart);
  overlay.addEventListener('click', closeCart);

  // Delegación de eventos para qty +/- y eliminar
  itemsEl.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLElement>('[data-qty-inc],[data-qty-dec],[data-cart-remove]');
    if (!btn) return;

    const incId = btn.dataset.qtyInc;
    const decId = btn.dataset.qtyDec;
    const remId = btn.dataset.cartRemove;
    const items = loadCart();

    if (incId) {
      const item = items.find(i => i.id === Number(incId));
      if (item) item.quantity++;
    } else if (decId) {
      const item = items.find(i => i.id === Number(decId));
      if (item) {
        item.quantity--;
        if (item.quantity <= 0) items.splice(items.indexOf(item), 1);
      }
    } else if (remId) {
      const idx = items.findIndex(i => i.id === Number(remId));
      if (idx !== -1) items.splice(idx, 1);
    }

    saveCart(items);
    renderCart();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCart();
  });

  // Inicializar al cargar
  renderCart();
</script>
