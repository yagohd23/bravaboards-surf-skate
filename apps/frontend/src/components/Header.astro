---
/**
 * Header — BravaBoards
 * Menú dinámico desde Strapi: logo, navegación con dropdowns, hamburger móvil.
 * Sin texto hardcodeado.
 */
import type { GlobalData } from '../types/strapi';
import { getStrapiMediaUrl, getStrapiMediaAlt } from '../lib/strapi';

interface Props {
  global: GlobalData | null;
}

const { global: g } = Astro.props;

const logoUrl = getStrapiMediaUrl(g?.logo);
const logoAlt = getStrapiMediaAlt(g?.logo, g?.site_name ?? '');
const navItems = g?.nav_menu ?? [];
---

<header class="sticky top-0 z-50 bg-warm-white border-b border-sand-dark">
  <div class="container">
    <nav
      class="flex items-center justify-between h-16"
      aria-label={g?.site_name ?? ''}
    >
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center gap-2">
        {logoUrl
          ? <img
              src={logoUrl}
              alt={logoAlt}
              width="140"
              height="40"
              class="h-9 w-auto object-contain"
              loading="eager"
            />
          : <span class="text-xl font-bold tracking-tight text-ocean">
              {g?.site_name}
            </span>
        }
      </a>

      <!-- Navegación desktop -->
      {navItems.length > 0 && (
        <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0" role="list">
          {navItems.map((item) => (
            <li class="relative group" role="listitem">
              {item.children && item.children.length > 0
                ? <>
                    <button
                      class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-navy hover:text-ocean transition-colors rounded-md"
                      aria-haspopup="true"
                      aria-expanded="false"
                      data-dropdown-trigger
                    >
                      {item.label}
                      <svg
                        class="w-3.5 h-3.5 transition-transform group-hover:rotate-180"
                        viewBox="0 0 12 12"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <!-- Dropdown -->
                    <ul
                      class="absolute top-full left-0 mt-1 w-48 bg-warm-white border border-sand-dark rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 list-none p-1"
                      role="menu"
                    >
                      {item.children.map((child) => (
                        <li role="none">
                          <a
                            href={child.href}
                            class="block px-3 py-2 text-sm text-navy hover:text-ocean hover:bg-sand rounded-md transition-colors"
                            role="menuitem"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                : <a
                    href={item.href}
                    class="block px-3 py-2 text-sm font-medium text-navy hover:text-ocean transition-colors rounded-md"
                  >
                    {item.label}
                  </a>
              }
            </li>
          ))}
        </ul>
      )}

      <!-- Acciones: favoritos + carrito + hamburger -->
      <div class="flex items-center gap-1">

        <!-- Icono favoritos -->
        <a
          href="/favoritos"
          class="relative flex items-center justify-center w-10 h-10 rounded-md text-navy hover:text-coral hover:bg-sand transition-colors"
          aria-label={g?.ui_labels?.favorites_title ?? ''}
          id="fav-header-link"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.27 2 8.5 2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.54L12 21.35z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </svg>
          <span
            id="fav-badge"
            class="absolute -top-0.5 -right-0.5 min-w-4.5 h-4.5 bg-coral text-warm-white text-[10px] font-bold rounded-full hidden items-center justify-center px-1"
            aria-hidden="true"
          ></span>
        </a>

        <!-- Icono carrito (visible en todos los tamaños) -->
        <button
          class="relative flex items-center justify-center w-10 h-10 rounded-md text-navy hover:text-ocean hover:bg-sand transition-colors"
          data-cart-open
          type="button"
          aria-label={g?.ui_labels?.cart_title ?? ''}
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M3 6h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span
            id="cart-badge"
            class="absolute -top-0.5 -right-0.5 min-w-4.5 h-4.5 bg-coral text-warm-white text-[10px] font-bold rounded-full hidden items-center justify-center px-1"
            aria-hidden="true"
          ></span>
        </button>

        <!-- Hamburger móvil -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-md text-navy hover:text-ocean hover:bg-sand transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label={g?.ui_labels?.mobile_menu_label ?? ''}
        >
        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" aria-hidden="true" id="icon-open">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="w-5 h-5 hidden" viewBox="0 0 20 20" fill="none" aria-hidden="true" id="icon-close">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      </div> <!-- /acciones -->
    </nav>
  </div>

  <!-- Menú móvil -->
  {navItems.length > 0 && (
    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-sand-dark bg-warm-white"
    >
      <ul class="container py-3 flex flex-col gap-0.5 list-none" role="list">
        {navItems.map((item) => (
          <li role="listitem">
            <a
              href={item.href}
              class="block px-3 py-2.5 text-sm font-medium text-navy hover:text-ocean hover:bg-sand rounded-md transition-colors"
            >
              {item.label}
            </a>
            {item.children && item.children.length > 0 && (
              <ul class="pl-4 mt-0.5 flex flex-col gap-0.5 list-none">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block px-3 py-2 text-sm text-stone hover:text-ocean hover:bg-sand rounded-md transition-colors"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  )}
</header>

<script>
  // ── Badge de favoritos ───────────────────────────────────────────────────────
  function updateFavBadge(count: number): void {
    const badge = document.getElementById('fav-badge');
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count > 99 ? '99+' : String(count);
      badge.classList.remove('hidden');
      badge.classList.add('flex');
    } else {
      badge.classList.add('hidden');
      badge.classList.remove('flex');
    }
  }

  try {
    const favIds = JSON.parse(localStorage.getItem('bravaboards_favorites') ?? '[]') as number[];
    updateFavBadge(favIds.length);
  } catch { /* ignorar */ }

  // Actualizar badge al cambiar favoritos (misma pestaña: storage no dispara, usamos click)
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-fav-btn]')) {
      setTimeout(() => {
        try {
          const ids = JSON.parse(localStorage.getItem('bravaboards_favorites') ?? '[]') as number[];
          updateFavBadge(ids.length);
        } catch { /* ignorar */ }
      }, 0);
    }
  });

  // Sincronización entre pestañas
  window.addEventListener('storage', (e) => {
    if (e.key === 'bravaboards_favorites') {
      try {
        const ids = JSON.parse(e.newValue ?? '[]') as number[];
        updateFavBadge(ids.length);
      } catch { /* ignorar */ }
    }
  });

  // ── Badge del carrito ────────────────────────────────────────────────────────
  function updateCartBadge(count: number): void {
    const badge = document.getElementById('cart-badge');
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count > 99 ? '99+' : String(count);
      badge.classList.remove('hidden');
      badge.classList.add('flex');
    } else {
      badge.classList.add('hidden');
      badge.classList.remove('flex');
    }
  }

  // Leer contador del carrito desde localStorage al cargar la página
  try {
    const stored = JSON.parse(localStorage.getItem('bravaboards_cart') ?? '[]') as { quantity: number }[];
    updateCartBadge(stored.reduce((s, i) => s + i.quantity, 0));
  } catch { /* ignorar */ }

  // Actualizar badge cuando el carrito cambia
  document.addEventListener('cart:change', ((e: CustomEvent) => {
    updateCartBadge((e.detail as { count: number }).count);
  }) as EventListener);

  // Abrir el drawer del carrito al hacer click en el icono
  document.querySelector('[data-cart-open]')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('cart:open'));
  });

  // ── Hamburger toggle ──
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconOpen  = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // ── Dropdown accesibilidad por teclado (desktop) ──
  document.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      // Cierra todos los demás
      document.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]').forEach((b) => {
        if (b !== btn) b.setAttribute('aria-expanded', 'false');
      });
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  });

  // Cierra dropdowns al hacer click fuera
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-dropdown-trigger]')) {
      document.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // ── Smooth scroll para hash links (compensa la altura del header sticky) ──
  function scrollToHash(hash: string): void {
    const target = document.getElementById(hash);
    if (!target) return;
    const headerH = document.querySelector('header')?.offsetHeight ?? 64;
    const top = target.getBoundingClientRect().top + window.scrollY - headerH - 12;
    window.scrollTo({ top, behavior: 'smooth' });
  }

  // Intercepta clicks en enlaces con hash
  document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href') ?? '';
      const hashIdx = href.indexOf('#');
      if (hashIdx === -1) return;

      const hash     = href.slice(hashIdx + 1);
      const pagePath = href.slice(0, hashIdx) || window.location.pathname;

      // Solo intercepta si el destino es la página actual
      if (pagePath !== window.location.pathname) return;

      const target = document.getElementById(hash);
      if (!target) return;

      e.preventDefault();
      scrollToHash(hash);
      history.pushState(null, '', `#${hash}`);
    });
  });

  // Al cargar la página con un hash (ej: navegando desde otra página)
  if (window.location.hash) {
    const hash = window.location.hash.slice(1);
    // Pequeño delay para que el layout esté completamente renderizado
    setTimeout(() => scrollToHash(hash), 80);
  }
</script>
