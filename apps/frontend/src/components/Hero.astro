---
/**
 * Hero — BravaBoards
 * Fondo soporta: video MP4 directo, YouTube, Vimeo, o imagen estática.
 * La fuente viene siempre de Strapi (hero_video_url o hero_background).
 */
import type { HeroCTA, StrapiMedia } from '../types/strapi';
import { getStrapiMediaUrl, getStrapiMediaAlt } from '../lib/strapi';

interface Props {
  title: string;
  subtitle?: string | null;
  background?: StrapiMedia | null;
  videoUrl?: string | null;
  ctas?: HeroCTA[] | null;
}

const { title, subtitle, background, videoUrl, ctas } = Astro.props;

// ── Detección del tipo de video ───────────────────────────────────────────────

function getYouTubeId(url: string): string | null {
  const m = url.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/
  );
  return m ? m[1] : null;
}

function getVimeoId(url: string): string | null {
  const m = url.match(/(?:vimeo\.com\/|player\.vimeo\.com\/video\/)(\d+)/);
  return m ? m[1] : null;
}

type VideoType = 'youtube' | 'vimeo' | 'direct' | null;

let videoType: VideoType = null;
let youtubeId: string | null = null;
let vimeoId: string | null = null;

if (videoUrl) {
  youtubeId = getYouTubeId(videoUrl);
  vimeoId   = getVimeoId(videoUrl);
  if (youtubeId)      videoType = 'youtube';
  else if (vimeoId)   videoType = 'vimeo';
  else                videoType = 'direct';
}

// ── Imagen de fallback (si no hay video) ─────────────────────────────────────
const bgUrl = !videoType ? getStrapiMediaUrl(background) : null;
const bgAlt = getStrapiMediaAlt(background, title);

// ── URLs de embed ─────────────────────────────────────────────────────────────
const youtubeEmbedUrl = youtubeId
  ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1&mute=1&loop=1&playlist=${youtubeId}&controls=0&modestbranding=1&showinfo=0&rel=0&iv_load_policy=3`
  : null;

const vimeoEmbedUrl = vimeoId
  ? `https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=1&loop=1&background=1&byline=0&title=0`
  : null;
---

<section
  class="relative w-full min-h-[80vh] flex items-center justify-center overflow-hidden bg-navy"
  aria-label={title}
>

  <!-- ── Fondo: video YouTube ───────────────────────────────────────────── -->
  {videoType === 'youtube' && youtubeEmbedUrl && (
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <iframe
        src={youtubeEmbedUrl}
        title=""
        allow="autoplay; fullscreen"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none border-0"
        style="width: max(100%, calc(100vh * 1.7778)); height: max(100%, calc(100vw * 0.5625));"
        loading="eager"
      />
    </div>
  )}

  <!-- ── Fondo: video Vimeo ────────────────────────────────────────────── -->
  {videoType === 'vimeo' && vimeoEmbedUrl && (
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <iframe
        src={vimeoEmbedUrl}
        title=""
        allow="autoplay; fullscreen"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none border-0"
        style="width: max(100%, calc(100vh * 1.7778)); height: max(100%, calc(100vw * 0.5625));"
        loading="eager"
      />
    </div>
  )}

  <!-- ── Fondo: MP4 / WebM directo ─────────────────────────────────────── -->
  {videoType === 'direct' && videoUrl && (
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
      aria-hidden="true"
      preload="auto"
    >
      <source src={videoUrl} />
    </video>
  )}

  <!-- ── Fondo: imagen estática (fallback cuando no hay video) ─────────── -->
  {!videoType && bgUrl && (
    <img
      src={bgUrl}
      alt={bgAlt}
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
  )}

  <!-- ── Overlay degradado mediterráneo ────────────────────────────────── -->
  <div
    class="absolute inset-0 z-10"
    style="background: linear-gradient(to top, rgba(13,31,51,0.88) 0%, rgba(13,31,51,0.5) 50%, rgba(13,31,51,0.2) 100%);"
    aria-hidden="true"
  ></div>

  <!-- ── Contenido ─────────────────────────────────────────────────────── -->
  <div class="relative z-20 container text-center text-warm-white py-24">
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight leading-tight mb-6">
      {title}
    </h1>

    {subtitle && (
      <p class="text-lg sm:text-xl lg:text-2xl text-stone-light max-w-2xl mx-auto mb-10 leading-relaxed">
        {subtitle}
      </p>
    )}

    {ctas && ctas.length > 0 && (
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        {ctas.map((cta) =>
          cta.variant === 'primary'
            ? <a
                href={cta.href}
                class="inline-flex items-center justify-center px-8 py-3.5 bg-coral text-warm-white font-semibold text-sm tracking-wide rounded-md hover:bg-ocean transition-colors duration-200"
              >
                {cta.label}
              </a>
            : <a
                href={cta.href}
                class="inline-flex items-center justify-center px-8 py-3.5 border border-warm-white text-warm-white font-semibold text-sm tracking-wide rounded-md hover:bg-warm-white hover:text-navy transition-colors duration-200"
              >
                {cta.label}
              </a>
        )}
      </div>
    )}
  </div>
</section>
