---
/**
 * BaseLayout — BravaBoards
 * Layout base con SEO 100% dinámico desde Strapi.
 * No hay texto hardcodeado visible; solo estructura técnica.
 */
import '../styles/global.css';
import type { StrapiMedia, SiteTheme, UILabels } from '../types/strapi';
import CartDrawer from '../components/CartDrawer.astro';
import ProductModal from '../components/ProductModal.astro';

interface SEOProps {
  title?: string | null;
  description?: string | null;
  image?: StrapiMedia | null;
  canonical?: string | null;
  robots?: string | null;
}

interface Props {
  seo?: SEOProps;
  lang?: string;
  faviconUrl?: string | null;
  /** Paleta de colores desde Strapi → Global → theme (JSON).
   *  Se inyecta como variables CSS :root { --color-ocean: ...; }
   *  para que cualquier cambio en el CMS se refleje sin tocar código. */
  theme?: SiteTheme | null;
  /** Etiquetas de UI para CartDrawer y ProductModal */
  ui?: UILabels | null;
}

const { seo, lang = 'es', faviconUrl, theme, ui } = Astro.props;

// Construye el bloque :root { --color-xxx: yyy; } a partir del JSON de Strapi.
// Las claves con guión bajo se convierten a guión medio: ocean_light → --color-ocean-light
const themeCSS = theme
  ? `:root{${
      Object.entries(theme)
        .filter(([, v]) => Boolean(v))
        .map(([k, v]) => `--color-${k.replace(/_/g, '-')}:${v}`)
        .join(';')
    }}`
  : null;

const STRAPI_URL = import.meta.env.STRAPI_URL ?? 'http://localhost:1337';

// Canonical: valor del CMS si existe, si no URL actual de la petición
const canonicalUrl = seo?.canonical ?? Astro.url.href;

// OG image: construye URL absoluta desde el campo media de Strapi 5
const ogImageUrl = seo?.image?.url
  ? seo.image.url.startsWith('http')
    ? seo.image.url
    : `${STRAPI_URL}${seo.image.url}`
  : null;

const ogImageAlt = seo?.image?.alternativeText ?? seo?.title ?? '';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Tema visual: colores del CMS → CSS custom properties (:root) -->
    {themeCSS && <Fragment set:html={`<style>${themeCSS}</style>`} />}

    <!-- Favicon: dinámico desde Strapi si existe, si no estático del repo -->
    {faviconUrl
      ? <link rel="icon" href={faviconUrl} />
      : <>
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link rel="icon" href="/favicon.ico" />
        </>
    }

    <!-- SEO principal -->
    {seo?.title       && <title>{seo.title}</title>}
    {seo?.description && <meta name="description" content={seo.description} />}
    {seo?.robots      && <meta name="robots" content={seo.robots} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    {seo?.title       && <meta property="og:title"       content={seo.title} />}
    {seo?.description && <meta property="og:description" content={seo.description} />}
    <meta property="og:url"  content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {ogImageUrl && (
      <>
        <meta property="og:image"     content={ogImageUrl} />
        <meta property="og:image:alt" content={ogImageAlt} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    {seo?.title       && <meta name="twitter:title"       content={seo.title} />}
    {seo?.description && <meta name="twitter:description" content={seo.description} />}
    {ogImageUrl       && <meta name="twitter:image"       content={ogImageUrl} />}
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    <slot />
    <CartDrawer ui={ui ?? {}} />
    <ProductModal ui={ui ?? {}} />
  </body>
</html>
