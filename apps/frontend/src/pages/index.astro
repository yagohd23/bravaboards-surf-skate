---
/**
 * Home — BravaBoards
 * Todo el contenido visible viene de Strapi. Sin texto hardcodeado.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CategoryCards from '../components/CategoryCards.astro';
import Footer from '../components/Footer.astro';
import {
  getGlobalData,
  getHomeData,
  getCategories,
  getStrapiMediaUrl,
} from '../lib/strapi';
import type { GlobalData, HomeData, Category } from '../types/strapi';

// ── Fetch paralelo de todos los datos ─────────────────────────────────────────
const [rawGlobal, rawHome, rawCategories] = await Promise.all([
  getGlobalData(),
  getHomeData(),
  getCategories(),
]);

const global     = rawGlobal     as GlobalData | null;
const home       = rawHome       as HomeData   | null;
const categories = rawCategories as Category[] ?? [];

// ── SEO ───────────────────────────────────────────────────────────────────────
const ui = global?.ui_labels ?? {};

const seo = {
  title:       home?.seo_title       ?? global?.seo_title       ?? null,
  description: home?.seo_description ?? global?.seo_description ?? null,
  image:       home?.seo_image       ?? global?.seo_image       ?? null,
  canonical:   home?.seo_canonical   ?? null,
  robots:      home?.seo_robots      ?? global?.seo_robots      ?? 'index, follow',
};

const faviconUrl = getStrapiMediaUrl(global?.favicon);
---

<BaseLayout seo={seo} faviconUrl={faviconUrl}>
  <Header global={global} />

  <main id="main-content">
    <!-- Hero -->
    {home?.hero_title && (
      <Hero
        title={home.hero_title}
        subtitle={home.hero_subtitle}
        background={home.hero_background}
        videoUrl={getStrapiMediaUrl(home.hero_video)}
        ctas={home.hero_ctas}
      />
    )}

    <!-- 4 tarjetas de categoría → llevan a /[slug] -->
    <CategoryCards categories={categories} ui={ui} />
  </main>

  <Footer global={global} />
</BaseLayout>
